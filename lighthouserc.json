{
  "ci": {
    "collect": {
      "url": [
        "https://APP_URL/survey/sp"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "throttlingMethod": "simulate",
        "onlyCategories": ["performance"],
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 390,
          "height": 844,
          "deviceScaleFactor": 3,
          "disabled": false
        }
      }
    },
    "assert": {
      "assertions": {
        "first-contentful-paint":   ["error", { "maxNumericValue": 2000, "aggregationMethod": "median" }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500, "aggregationMethod": "median" }],
        "total-blocking-time":      ["error", { "maxNumericValue": 300,  "aggregationMethod": "median" }],
        "interactive":              ["warn",  { "maxNumericValue": 3500, "aggregationMethod": "median" }],
        "speed-index":              ["warn",  { "maxNumericValue": 3000, "aggregationMethod": "median" }],
        "categories:performance":   ["warn",  { "minScore": 0.8 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}